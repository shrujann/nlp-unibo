# OpenRouter API (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Models (override defaults if needed)
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash

# FatSecret API (https://platform.fatsecret.com/api/Default.aspx?screen=r)
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

# Cloudflare D1
# 1. Create account at dash.cloudflare.com
# 2. Run: npx wrangler d1 create nlp-food-log
# 3. Apply migration: npx wrangler d1 execute nlp-food-log --remote --file=migrations/001_init.sql
# 4. Create API token at dash.cloudflare.com/profile/api-tokens (D1 Edit permission)
CLOUDFLARE_ACCOUNT_ID=
CF_D1_DATABASE_ID=e7f32422-b61b-4262-a752-8318616907a6
CLOUDFLARE_API_TOKEN=

# Chainlit auth — run `chainlit create-secret` to generate
CHAINLIT_AUTH_SECRET=

# Arize Phoenix
# Project name shown in the Phoenix UI (default: food-log)
# PHOENIX_PROJECT=food-log
# Where Phoenix stores its SQLite database — keep project-local so experiments persist
PHOENIX_WORKING_DIR=.phoenix

